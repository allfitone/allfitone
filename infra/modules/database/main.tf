/**
 * Production PostgreSQL on RDS.
 *
 * The rules that protect health data live in this database (policies, triggers,
 * functions), so the instance itself is locked down accordingly: private subnets
 * only, reachable on 5432 from named security groups and nothing else, encrypted
 * at rest, TLS required in transit, seven days of point-in-time recovery, and
 * protected against deletion. One zone for now; `multi_az` adds a standby.
 *
 * The master password is ephemeral: generated by the caller during the apply, handed to RDS
 * and to the environment's secret as write-only values, and never stored in
 * code or in Terraform state. The secret holds every credential of the
 * environment (database and app), so later app keys are added to the same
 * JSON by hand; Terraform writes it only when the *_wo_version numbers move.
 * Rotating means bumping both versions and then restoring the app keys.
 */

locals {
  master_username = "dbmaster"
}

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

resource "aws_db_subnet_group" "this" {
  name       = var.name
  subnet_ids = var.private_subnet_ids

  tags = { Name = var.name }
}

resource "aws_security_group" "this" {
  name        = "${var.name}-postgres"
  description = "PostgreSQL, reachable only from the listed client groups"
  vpc_id      = var.vpc_id

  tags = { Name = "${var.name}-postgres" }
}

resource "aws_vpc_security_group_ingress_rule" "postgres" {
  for_each = var.client_security_group_ids

  security_group_id            = aws_security_group.this.id
  referenced_security_group_id = each.value
  ip_protocol                  = "tcp"
  from_port                    = 5432
  to_port                      = 5432
  description                  = "PostgreSQL from ${each.key}"
}

resource "aws_db_parameter_group" "this" {
  name   = "${var.name}-postgres17"
  family = "postgres17"

  # Static parameter: AWS records it as pending-reboot, so say so or every plan shows drift.
  parameter {
    name         = "rds.force_ssl"
    value        = "1"
    apply_method = "pending-reboot"
  }

  # Statements slower than a second land in the log, where they can be found.
  parameter {
    name  = "log_min_duration_statement"
    value = "1000"
  }
}

resource "aws_db_instance" "this" {
  identifier     = var.name
  engine         = "postgres"
  engine_version = "17"
  instance_class = var.instance_class

  allocated_storage     = var.allocated_storage_gb
  max_allocated_storage = var.max_allocated_storage_gb
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name = "postgres"
  # Not allfit_*: that prefix is for the schema's own roles and for a person's platform role.
  username            = local.master_username
  password_wo         = var.master_password
  password_wo_version = 1

  db_subnet_group_name   = aws_db_subnet_group.this.name
  vpc_security_group_ids = [aws_security_group.this.id]
  parameter_group_name   = aws_db_parameter_group.this.name
  publicly_accessible    = false
  multi_az               = var.multi_az

  backup_retention_period    = 7
  backup_window              = "07:00-08:00"
  maintenance_window         = "sun:08:30-sun:09:30"
  auto_minor_version_upgrade = true
  copy_tags_to_snapshot      = true

  deletion_protection       = true
  skip_final_snapshot       = false
  final_snapshot_identifier = "${var.name}-final"

  performance_insights_enabled    = true
  enabled_cloudwatch_logs_exports = ["postgresql"]

  tags = { Name = var.name }

  lifecycle {
    prevent_destroy = true
  }
}

resource "aws_secretsmanager_secret_version" "database" {
  secret_id = var.environment_secret_id
  secret_string_wo = jsonencode({
    DB_HOST            = aws_db_instance.this.address
    DB_PORT            = aws_db_instance.this.port
    DB_NAME            = aws_db_instance.this.db_name
    DB_MASTER_USERNAME = local.master_username
    DB_MASTER_PASSWORD = var.master_password
  })
  secret_string_wo_version = 1

  # App keys are added to this secret by hand, which makes a newer version current.
  lifecycle {
    ignore_changes = [version_stages]
  }
}

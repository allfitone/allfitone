{
  "name": "@allfitone/notifications",
  "version": "0.0.0",
  "private": true,
  "description": "Notification ports, invitation tokens and provider adapters",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./ses": {
      "types": "./src/ses.ts",
      "bun": "./src/ses.ts",
      "import": "./dist/ses.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1145.0"
  }
}
